# Caddy terminates TLS (automatic Let's Encrypt certificates for $DOMAIN) and forwards everything to the frontend
# container, whose nginx serves the app and proxies /api to the API. Set DOMAIN=localhost to test locally.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Basic abuse protection in front of the app: limit request bodies (the API enforces the real upload limit).
	request_body {
		max_size 25MB
	}

	# /metrics is for Prometheus on the internal network only.
	@internal path /metrics
	respond @internal 404

	reverse_proxy frontend:8080 {
		flush_interval -1   # do not buffer Server-Sent Events
		header_up X-Forwarded-For {remote_host}
	}
}
