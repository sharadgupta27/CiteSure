# Copy to .env and edit. Never commit .env. Variables are documented in docs/architecture.md.

# --- Core ---
ENV=dev                                   # dev | test | prod
DATABASE_URL=postgresql+asyncpg://citesure:citesure@localhost:5432/citesure
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# --- Providers ---
LLM_PROVIDER=fake                         # fake | anthropic
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
VERIFY_MODEL=claude-haiku-5-5
EMBEDDING_PROVIDER=fake                   # fake | fastembed | voyage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER=lexical                          # cross-encoder | lexical | none
RERANK_ENABLED=true
VOYAGE_API_KEY=

# --- Retrieval / verification ---
CANDIDATE_K=30
TOP_K=6
QUOTE_MATCH_MIN=0.9
CHUNK_TOKENS=400
CHUNK_OVERLAP=0.15

# --- Storage ---
STORAGE_BACKEND=local                     # local | s3
STORAGE_PATH=./uploads
S3_BUCKET=
MAX_UPLOAD_MB=20

# --- Limits ---
RATE_LIMIT_ASK_PER_MIN=30
RATE_LIMIT_AUTH_PER_MIN=20
UPLOADS_ENABLED=true

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=              # e.g. http://otel-collector:4318 (empty = tracing off)

# --- MCP server / agents (service user, scoped) ---
CITESURE_URL=http://localhost:8000
CITESURE_MCP_EMAIL=agent@acme.example
CITESURE_MCP_PASSWORD=
