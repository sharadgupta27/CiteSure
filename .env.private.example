# Private stack (docker-compose.private.yml). Copy to .env and fill in. Never commit .env.
# Company documents are read only by a model on this machine; the API may reach only the hosts in deploy/egress/allowlist.txt.

# --- secrets (required) -----------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=                  # openssl rand -hex 24
JWT_SECRET=                         # 32+ random characters: python -c "import secrets;print(secrets.token_urlsafe(48))"
SEED_PASSWORD=                      # password of the demo logins created by `python -m app.seed`

# --- the local model (internal lane) ------------------------------------------------------------------------------------
LOCAL_ANSWER_MODEL=llama3.2:3b      # ~2 GB download, ~4 GB RAM, fine on CPU. Other small picks: phi4-mini, gemma3:4b, qwen2.5:1.5b, llama3.2:1b
LOCAL_VERIFY_MODEL=llama3.2:3b      # the verifier decides what gets dropped; keep it equal to the answer model unless you measured a smaller one

# --- the public lane ---------------------------------------------------------------------------------------------------
PUBLIC_RESEARCH_ENABLED=true        # false = nothing ever leaves, the scope selector disappears
DEFAULT_SCOPE=internal              # internal | public | both
PUBLIC_SOURCES=arxiv,crossref,openalex,europepmc,semanticscholar    # + web (needs EGRESS_MODE=open and Anthropic)
CONTACT_EMAIL=                      # optional: Crossref/OpenAlex give polite-pool (faster) service to identified clients

# Claude, for PUBLIC text only: it answers public-only questions and finds web pages. It never receives company text.
PUBLIC_LLM_PROVIDER=none            # none | anthropic
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
VERIFY_MODEL=claude-haiku-5-5

EGRESS_MODE=allowlist               # allowlist = only deploy/egress/allowlist.txt | open = any public https page (web source)
# Words that must never leave, comma separated: project code names, customer names, internal product names.
EGRESS_DENY_TERMS=
# Generic document titles that are safe to search for (otherwise a title like "Parental Leave Policy" blocks the search).
EGRESS_ALLOW_TERMS=
# Secret marker strings planted in documents; any outbound text containing one is blocked and counted.
EGRESS_CANARIES=

# Open-access full text of published papers, added on demand (docs/open-access-fulltext.md). Public text only.
FULLTEXT_ENABLED=                   # empty = follow PUBLIC_RESEARCH_ENABLED | false = abstracts only
FULLTEXT_DAILY_FETCHES=20           # downloads per workspace per day (0 = none); papers already cached are free
FULLTEXT_MAX_BYTES=25000000         # largest PDF accepted for one paper
FULLTEXT_CACHE_TTL_DAYS=30          # after this a cached paper is ignored and fetched afresh

# --- phase 2: watched-folder inbox (optional; docs/viewer-and-inbox.md) ---------------------------------------------
INBOX_ROOT=                         # empty = off | /data/inbox = on (the folder below is mounted there)
INBOX_HOST_DIR=./inbox              # host folder: <workspace folder>/<collection name>/<file>
INBOX_POLL_SECONDS=30
INBOX_MAX_FILE_MB=20

# --- phase 5: audit, vault, OCR, optional OIDC (docs/audit-dashboard.md, docs/vault-and-ocr.md, docs/oidc.md) -----------
# The audit log and dashboard need no settings. Everything below is off by default.
VAULT_ENABLED=false                 # true = uploaded files are AES-GCM encrypted at rest; set VAULT_KEY or VAULT_KEY_FILE first
VAULT_KEY=                          # base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_KEY_ID=k1
OCR_ENABLED=false                   # true needs WITH_OCR=true at build time
WITH_OCR=false
OCR_LANGS=eng                       # Tesseract language packs installed in the image, space separated
OIDC_ENABLED=false                  # true = "Sign in with ..." button; the provider must run on the internal network (private mode)
OIDC_ISSUER=                        # e.g. http://keycloak:8080/realms/acme
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=                  # https://<your host>/api/v1/auth/oidc/callback
OIDC_AUTO_CREATE_USERS=false
OIDC_ONLY=false                     # true = password login and registration are off

# --- front door -----------------------------------------------------------------------------------------------------
BIND_ADDRESS=127.0.0.1              # 0.0.0.0 publishes the port to your network: put a VPN or an access proxy in front first
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80                    # :80 = plain HTTP on this machine | citesure.example.com = automatic HTTPS
CORS_ORIGINS=http://localhost:8080

# --- EvalOps (optional) -----------------------------------------------------------------------------------------------
# Used by CI or by `backend/evals/publish_to_evalops.py`; PRIVATE_MODE makes the exports carry no question or answer text.
EVALOPS_URL=
